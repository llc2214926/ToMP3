<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ToMP3"
        x:Class="ToMP3.AudioConvertWindow" x:Name="Root"
        Title="ToMP3"
        Width="980" Height="700" MinWidth="800" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome,OSXThickTitleBar"
        ExtendClientAreaTitleBarHeightHint="64"
        WindowStartupLocation="CenterScreen"
        FontFamily="PingFang SC, Microsoft YaHei UI, Noto Sans CJK SC, Segoe UI, sans-serif"
        FontSize="13" Icon="/Assets/icon.png"
        Background="{StaticResource BrushWindowBg}">

  <Window.Resources>
    <local:TipText x:Key="TipText" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="DataGrid">
      <Setter Property="RowHeight" Value="40" />
    </Style>
    <!-- 单元格文字放不下时给省略号，并把完整内容挂成悬停提示：文件名、路径和失败原因都可能超宽，
         硬裁切会把字切掉一半。列仍可拖宽（CanUserResizeColumns）。 -->
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip.Tip" Value="{Binding $self.Text, Converter={StaticResource TipText}}" />
      <!-- 默认 400ms 才弹，看被截断的文字要等；鼠标放上就显示。 -->
      <Setter Property="ToolTip.ShowDelay" Value="0" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">
    <!-- 原生红黄绿按钮保留在左侧，整条顶部区域与窗口使用同一背景。 -->
    <Border DockPanel.Dock="Top" Height="64" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
      <Grid Margin="100,0,24,0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="/Assets/icon.png" Width="32" Height="32" />
          <TextBlock Text="ToMP3" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{StaticResource BrushTextPrimary}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="让音乐自由播放" FontSize="12" VerticalAlignment="Center"
                   IsHitTestVisible="False" Foreground="{StaticResource BrushTextSecondary}" />
      </Grid>
    </Border>

    <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top" Margin="24,8,24,10" Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="音乐格式转换" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" />
          <TextBlock Text="添加音乐文件，选择位置，开始转换。" FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}" />
        </StackPanel>
        <Button Grid.Column="1" Content="选择文件夹/文件" Classes="primary" Click="OnPickSources"
                VerticalAlignment="Center" ToolTip.Tip="可同时选择文件和文件夹；文件夹会递归查找支持的格式" />
      </Grid>

      <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="1" CornerRadius="10" Padding="12,6">
        <StackPanel Spacing="4">
          <ToggleButton x:Name="FormatToggle" HorizontalAlignment="Left" Classes="quiet"
                        ToolTip.Tip="展开或收起完整格式列表">
            <TextBlock x:Name="FormatSummary" FontSize="12" VerticalAlignment="Center" />
          </ToggleButton>
          <ScrollViewer x:Name="FormatScroll" Height="76" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding IsChecked, ElementName=FormatToggle}">
            <TextBlock x:Name="FormatHint" TextWrapping="Wrap" FontSize="12" Width="{Binding Viewport.Width, ElementName=FormatScroll}"
                       Foreground="{StaticResource BrushTextSecondary}" />
          </ScrollViewer>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="输出位置" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Foreground="{StaticResource BrushTextSecondary}" />
            <TextBox Grid.Column="1" x:Name="OutDirBox" IsReadOnly="True" Classes="output" MinHeight="28" Padding="0,4"
                     ToolTip.Tip="默认与源文件同目录；同名文件会被覆盖" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
              <Button Content="更改位置" Classes="compact" Click="OnPickOutDir" />
              <Button Content="恢复默认" Classes="quiet compact" Click="OnClearOutDir" ToolTip.Tip="与源文件同目录" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="24,18,24,20">
      <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock x:Name="FooterText" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource BrushTextPrimary}" />
        <TextBlock Text="保留源文件 · 同名输出会覆盖" FontSize="11"
                   Foreground="{StaticResource BrushTextSecondary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="打开输出目录" Click="OnOpenOutDir" />
        <Button x:Name="BtnStop" Content="停止" Classes="danger" Click="OnStop" IsEnabled="False" />
        <Button x:Name="BtnStart" Content="开始转换" Classes="primary" Click="OnStart" MinWidth="110" />
      </StackPanel>
    </Grid>
    <Border Margin="24,0,24,0" Background="{StaticResource BrushCard}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="12,4">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="转换列表" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock Text="{Binding Items.Count, ElementName=Root, StringFormat='{}{0} 个文件'}"
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="移除选中" Classes="quiet compact" Click="OnRemove" />
            <Button Content="清空" Classes="quiet compact" Click="OnClear" />
          </StackPanel>
        </Grid>
        <Grid>
        <DataGrid x:Name="Grid" Background="Transparent" BorderThickness="0,1,0,0"
                  BorderBrush="{StaticResource BrushBorder}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CanUserResizeColumns="True" SelectionMode="Single" FontSize="12.5"
                  DoubleTapped="OnRowDoubleTapped">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="在访达中显示" Click="OnReveal" />
              <MenuItem Header="重新转换" Click="OnRedo" />
              <Separator />
              <MenuItem Header="移除" Click="OnRemove" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn x:DataType="local:Job" Header="文件名" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
            <DataGridTextColumn x:DataType="local:Job" Header="所在文件夹" Binding="{Binding Folder}" SortMemberPath="Folder" Width="2*" />
            <!-- 状态要按值上色，DataGridTextColumn 的 Foreground 是整列的，只能用模板列；
                 边距对齐 DataGridTextColumn 自己生成的 TextBlock。 -->
            <DataGridTemplateColumn Header="状态" SortMemberPath="Status" Width="84">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="local:Job">
                  <!-- 状态列永远放得下，不需要悬停提示（本地值盖掉公共样式里的 Tip）。 -->
                  <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                             Margin="12,0" VerticalAlignment="Center" ToolTip.Tip="{x:Null}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:DataType="local:Job" Header="说明" Binding="{Binding Note}" SortMemberPath="Note" Width="3*" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Spacing="10" Margin="0,32,0,0" VerticalAlignment="Center"
                    HorizontalAlignment="Center" IsHitTestVisible="False"
                    IsVisible="{Binding !Items.Count, ElementName=Root}">
          <Image Source="/Assets/icon.png" Width="32" Height="32" Opacity="0.85" />
          <TextBlock Text="把音乐拖到这里" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"
                     Foreground="{StaticResource BrushTextPrimary}" />
        </StackPanel>
        </Grid>
      </DockPanel>
    </Border>

  </DockPanel>
</Window>
