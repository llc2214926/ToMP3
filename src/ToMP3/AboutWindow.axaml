<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ToMP3.AboutWindow" Title="{DynamicResource T_AboutTitle}" Width="420" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.png">
  <StackPanel Margin="32,24,32,28" Spacing="12">
    <Image Source="/Assets/icon.png" Width="88" Height="88" HorizontalAlignment="Center" />
    <TextBlock Text="ToMP3" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock x:Name="VersionText" Classes="muted" HorizontalAlignment="Center" />
    <TextBlock Text="{DynamicResource T_AboutSubtitle}" FontSize="15" HorizontalAlignment="Center" />
    <TextBlock Text="{DynamicResource T_AboutDescription}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Classes="muted" />
    <Border Classes="card" Padding="14" Margin="0,4"><StackPanel Spacing="8">
      <TextBlock x:Name="PlatformText" HorizontalAlignment="Center" Classes="muted" />
      <TextBlock Text="{DynamicResource T_AboutTools}" TextAlignment="Center" Classes="caption" />
      <TextBlock Text="{DynamicResource T_AboutLossy}" TextAlignment="Center" Classes="caption" />
    </StackPanel></Border>
    <Button Content="{DynamicResource T_Close}" Classes="primary" HorizontalAlignment="Center" MinWidth="112" IsDefault="True" IsCancel="True" Click="OnClose" />
  </StackPanel>
</Window>
