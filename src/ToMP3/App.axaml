<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToMP3.App" Name="ToMP3"
             RequestedThemeVariant="Light">

  <!-- 应用级 NativeMenu 显示在 macOS 左侧应用菜单，保留系统隐藏/退出项。 -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="关于 ToMP3" Click="OnAbout" />
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Resources>

    <!-- ToMP3：冷白背景、蓝色主操作、低对比度边框。 -->
    <SolidColorBrush x:Key="BrushPrimary"        Color="#2563EB" />
    <SolidColorBrush x:Key="BrushPrimaryHover"   Color="#1D4ED8" />
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="#1E40AF" />

    <SolidColorBrush x:Key="BrushWindowBg" Color="#F5F7FB" />
    <SolidColorBrush x:Key="BrushCard"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushBorder"   Color="#E4E9F1" />
    <SolidColorBrush x:Key="BrushHeaderBg" Color="#F8FAFD" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="BrushTextPrimary"   Color="#111827" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#6B7280" />

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- DataGrid 的主题需要单独引入 -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- 复用 Fluent 交互模板，统一内容对齐和圆角焦点环。 -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="#D5DDE9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="White" BorderThickness="1" CornerRadius="9" Margin="1">
            <Border BorderBrush="#1D4ED8" BorderThickness="2" CornerRadius="8" />
          </Border>
        </Template>
      </Setter>
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EDF2FA" />
      <Setter Property="BorderBrush" Value="#CBD7E8" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2EAF6" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="#F1F4F9" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#475569" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushPrimaryHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryHover}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushPrimaryPressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryPressed}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFF5F5" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="BorderBrush" Value="#F4CACA" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="BorderBrush" Value="#ECAAAA" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FECACA" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F0F2F6" />
      <Setter Property="Foreground" Value="#8A94A4" />
      <Setter Property="BorderBrush" Value="#E4E8EF" />
    </Style>

    <!-- ▍输入控件：统一圆角与内边距 -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBox.output">
      <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThicknessFocused}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.output:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
    </Style>

    <!-- ▍DataGrid 表头：浅灰底 + 加粗 -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource BrushHeaderBg}" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </Application.Styles>
</Application>
