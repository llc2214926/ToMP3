<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ToMP3.AboutWindow"
        Title="关于 ToMP3" Width="400" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="PingFang SC, Microsoft YaHei UI, sans-serif"
        FontSize="13" Icon="/Assets/icon.png"
        Background="{StaticResource BrushWindowBg}">
  <StackPanel Margin="32,24,32,28" Spacing="12">
    <Image Source="/Assets/icon.png" Width="88" Height="88" HorizontalAlignment="Center" />
    <TextBlock Text="ToMP3" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
               Foreground="{StaticResource BrushTextPrimary}" />
    <TextBlock x:Name="VersionText" HorizontalAlignment="Center"
               Foreground="{StaticResource BrushTextSecondary}" />
    <TextBlock Text="音乐格式转换工具" FontSize="15" HorizontalAlignment="Center"
               Foreground="{StaticResource BrushTextPrimary}" />
    <TextBlock Text="批量解包加密音乐，保留原始音质。支持拖入文件、文件夹及自选输出位置。"
               TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"
               Foreground="{StaticResource BrushTextSecondary}" />
    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14" Margin="0,4">
      <StackPanel Spacing="8">
        <TextBlock x:Name="PlatformText" HorizontalAlignment="Center"
                   Foreground="{StaticResource BrushTextSecondary}" />
        <TextBlock Text="转换内核：ncmdump 1.5.1 · Unlock Music 0.2.12"
                   FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
        <TextBlock Text="输出为源音频格式（可能是 MP3、FLAC、OGG 等），不强制转码为 MP3。"
                   TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                   Foreground="{StaticResource BrushTextSecondary}" />
      </StackPanel>
    </Border>
    <Button Content="关闭" Classes="primary" HorizontalAlignment="Center" MinWidth="100"
            IsDefault="True" IsCancel="True" Click="OnClose" />
  </StackPanel>
</Window>
